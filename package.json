{
  "name": "auditcore-js",
  "private": true,
  "description": "JavaScript-/TypeScript-Pakete von auditcore (npm-Workspaces)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages-js/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint packages-js scripts/js",
    "lint:exceptions": "node scripts/js/count-lint-exceptions.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "license-check": "node scripts/js/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  }
}
