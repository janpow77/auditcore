{
  "name": "@flowaudit/bpmn-editor",
  "version": "0.1.1",
  "description": "Eigener BPMN-2.0-Zeicheneditor auf Basis von diagram-js und bpmn-moddle (Clean-Room, MIT)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpow77/auditcore.git",
    "directory": "packages-js/bpmn-editor"
  },
  "homepage": "https://github.com/janpow77/auditcore/tree/main/packages-js/bpmn-editor#readme",
  "bugs": {
    "url": "https://github.com/janpow77/auditcore/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/bpmn-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "PROVENANCE.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo": "vite --config demo/vite.demo.config.ts"
  },
  "dependencies": {
    "bpmn-moddle": "^10.3.1",
    "diagram-js": "^15.27.1",
    "didi": "^11.0.0",
    "min-dash": "^5.1.0",
    "min-dom": "^5.3.0",
    "tiny-svg": "^4.1.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "bpmn",
    "bpmn-2.0",
    "editor",
    "diagram-js",
    "flowaudit"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
