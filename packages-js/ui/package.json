{
  "name": "@flowaudit/ui",
  "version": "0.2.0",
  "description": "Gemeinsame FlowAudit-Oberflächenkomponenten: Vue 3, Web Components, Theming und i18n",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/elements.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./style.css": "./dist/ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:api": "playwright test -c e2e/playwright.api.config.ts"
  },
  "dependencies": {
    "@flowaudit/common": "0.1.0",
    "@flowaudit/kanban-core": "0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
