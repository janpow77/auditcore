{
  "name": "@auditcore/sampling-templates-vue",
  "version": "0.1.5",
  "description": "Vue-3-Oberfläche der Stichprobenvorlagen 2021–2027 nach DelVO (EU) 2023/67: Stichprobenrechner mit Verfahrensauswahl, Rechenblatt, Ergebnisspalte, Arbeitsstand als Datei und Excel-Export (MIT)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpow77/auditcore.git",
    "directory": "packages-js/sampling-templates-vue"
  },
  "homepage": "https://github.com/janpow77/auditcore/tree/main/packages-js/sampling-templates-vue#readme",
  "bugs": {
    "url": "https://github.com/janpow77/auditcore/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/sampling-templates-vue.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo": "vite -c demo/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auditcore/common": "0.1.1",
    "@auditcore/sampling-templates-core": "0.1.5",
    "@auditcore/ui": ">=0.4.0 <0.6.0",
    "@auditcore/ui-core": ">=0.3.0 <0.5.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
