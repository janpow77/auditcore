{
  "name": "@flowaudit/bpmn-flowaudit",
  "version": "0.2.1",
  "description": "FlowAudit-Fachschicht für den BPMN-Editor: Schema flowaudit 1.0/1.1, Akteure, Kennzeichen, Prüfbezüge, Prüfpfad, Durchlauftest, Soll/Ist, Neutralisieren, Berichte und framework-freier Kern der Editor-Oberfläche (framework-frei, MIT)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profiles": {
      "types": "./dist/profile/bundled.d.ts",
      "import": "./dist/profiles.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui.js"
    },
    "./style.css": "./dist/bpmn-flowaudit.css",
    "./ui.css": "./dist/ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && node -e \"require('node:fs').copyFileSync('src/ui/ui.css','dist/ui.css')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "bpmn-moddle": "^10.3.1"
  },
  "peerDependencies": {
    "@flowaudit/bpmn-editor": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@flowaudit/bpmn-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "diagram-js": "^15.27.1"
  }
}
