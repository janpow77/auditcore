<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Rahmen" targetNamespace="urn:auditcore:test:rahmen">
  <bpmn:collaboration id="Collab_Rahmen">
    <bpmn:participant id="Pool_A" name="Stelle A" processRef="Proc_A" />
    <bpmn:group id="Group_1" categoryValueRef="CatVal_1" />
    <bpmn:textAnnotation id="Note_1"><bpmn:text>Hinweis am Rand</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:category id="Cat_1"><bpmn:categoryValue id="CatVal_1" value="Gruppe" /></bpmn:category>
  <bpmn:process id="Proc_A" isExecutable="false">
    <bpmn:laneSet id="LaneSet_A">
      <bpmn:lane id="Lane_A1" name="Bahn 1"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Sub_1</bpmn:flowNodeRef><bpmn:flowNodeRef>End_1</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Beginn"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="Sub_1" name="Teilprozess">
      <bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:task id="Task_Innen" name="Innere Aufgabe" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_1" name="Ende"><bpmn:incoming>Flow_2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Sub_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Sub_1" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Rahmen">
    <bpmndi:BPMNPlane id="Plane_Rahmen" bpmnElement="Collab_Rahmen">
      <bpmndi:BPMNShape id="Pool_A_di" bpmnElement="Pool_A" isHorizontal="true"><dc:Bounds x="100" y="80" width="760" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_A1_di" bpmnElement="Lane_A1" isHorizontal="true"><dc:Bounds x="130" y="80" width="730" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="182" y="192" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_1_di" bpmnElement="Sub_1" isExpanded="true"><dc:Bounds x="280" y="120" width="360" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Innen_di" bpmnElement="Task_Innen"><dc:Bounds x="400" y="170" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="742" y="192" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="218" y="210" /><di:waypoint x="280" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="640" y="210" /><di:waypoint x="742" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Group_1_di" bpmnElement="Group_1"><dc:Bounds x="100" y="400" width="300" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_1_di" bpmnElement="Note_1"><dc:Bounds x="500" y="420" width="160" height="50" /></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
