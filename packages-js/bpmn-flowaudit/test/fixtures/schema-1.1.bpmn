        <dc:Bounds x="260" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataRef_Vermerk_di" bpmnElement="DataRef_Vermerk">
        <dc:Bounds x="292" y="420" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Vollst_di" bpmnElement="Gateway_Vollst" isMarkerVisible="true">
        <dc:Bounds x="410" y="325" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bewilligen_di" bpmnElement="Task_Bewilligen">
        <dc:Bounds x="520" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Nachfordern_di" bpmnElement="Task_Nachfordern">
        <dc:Bounds x="520" y="405" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Abbruch_di" bpmnElement="End_Abbruch">
        <dc:Bounds x="680" y="427" width="36" height="36" />
      </bpmndi:BPMNShape>
