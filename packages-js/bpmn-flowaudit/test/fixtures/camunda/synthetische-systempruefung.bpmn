<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:flowaudit="https://flowaudit.de/bpmn/schema/1.0" id="Def_Synthetisch" targetNamespace="https://example.org/bpmn/synthetisch" exporter="Camunda Modeler" exporterVersion="5.0.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
<bpmn:collaboration id="Collab_Synthetisch"><bpmn:documentation>Synthetisches Testmodell: Prüfungshandlungen mit Merkmalen als camunda:property.</bpmn:documentation><bpmn:participant id="Pool_Pruefteam" name="Prüfteam" processRef="Prozess_Synthetisch" /></bpmn:collaboration>
<bpmn:process id="Prozess_Synthetisch" name="Synthetische Systemprüfung" isExecutable="false"><bpmn:startEvent id="Start_PB" name="Synthetische Prüfung im Plan"><bpmn:extensionElements><camunda:properties><camunda:property name="pb_gj" value="2030/2031" /></camunda:properties></bpmn:extensionElements><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="T_Planung" name="Prüfung planen"><bpmn:extensionElements><camunda:properties><camunda:property name="pb_art" value="Planung" /></camunda:properties></bpmn:extensionElements><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task><bpmn:parallelGateway id="G_Split" name=""><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:parallelGateway><bpmn:task id="T_DT_KA4_Doppelfoerderung" name="Durchlauftest Beispiel A"><bpmn:extensionElements><camunda:properties><camunda:property name="pb_art" value="Durchlauftest" /><camunda:property name="pb_ka" value="4" /><camunda:property name="pb_bk" value="" /><camunda:property name="pb_coso" value="Kontrollaktivitäten" /><camunda:property name="pb_ziel" value="Ordnungsmäßigkeit" /><camunda:property name="pb_stelle" value="ZGS" /><camunda:property name="pb_rechtsgrundlage" value="Art. 1 Beispielverordnung" /><camunda:property name="pb_offen" value="ja" /></camunda:properties></bpmn:extensionElements><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:task id="T_DT_KA4_Interessenkonflikte" name="Durchlauftest Beispiel B"><bpmn:extensionElements><camunda:properties><camunda:property name="pb_art" value="Durchlauftest" /><camunda:property name="pb_ka" value="4" /><camunda:property name="pb_coso" value="Kontrollaktivitäten" /><camunda:property name="pb_stelle" value="ZGS" /><camunda:property name="x_fremd" value="bleibt" /></camunda:properties></bpmn:extensionElements><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:parallelGateway id="G_Join" name=""><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:parallelGateway><bpmn:task id="T_KT" name="Ergänzende Kontrolltests"><bpmn:extensionElements><camunda:properties><camunda:property name="pb_art" value="Kontrolltest" /><camunda:property name="pb_ka" value="1;4" /><camunda:property name="pb_ziel" value="Ordnungsmäßigkeit" /></camunda:properties><flowaudit:interneNotiz>Synthetische Notiz</flowaudit:interneNotiz></bpmn:extensionElements><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:endEvent id="End_PB" name="Prüfung abgeschlossen"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="Start_PB" targetRef="T_Planung" /><bpmn:sequenceFlow id="Flow_1" sourceRef="T_Planung" targetRef="G_Split" /><bpmn:sequenceFlow id="Flow_2" sourceRef="G_Split" targetRef="T_DT_KA4_Doppelfoerderung" /><bpmn:sequenceFlow id="Flow_3" sourceRef="G_Split" targetRef="T_DT_KA4_Interessenkonflikte" /><bpmn:sequenceFlow id="Flow_4" sourceRef="T_DT_KA4_Doppelfoerderung" targetRef="G_Join" /><bpmn:sequenceFlow id="Flow_5" sourceRef="T_DT_KA4_Interessenkonflikte" targetRef="G_Join" /><bpmn:sequenceFlow id="Flow_6" sourceRef="G_Join" targetRef="T_KT" /><bpmn:sequenceFlow id="Flow_7" sourceRef="T_KT" targetRef="End_PB" /></bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Synthetisch"><bpmndi:BPMNShape id="Pool_Pruefteam_di" bpmnElement="Pool_Pruefteam" isHorizontal="true"><dc:Bounds x="20" y="10" width="1040" height="320" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_PB_di" bpmnElement="Start_PB"><dc:Bounds x="80" y="152" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_Planung_di" bpmnElement="T_Planung"><dc:Bounds x="170" y="130" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_Split_di" bpmnElement="G_Split"><dc:Bounds x="370" y="145" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_DT_KA4_Doppelfoerderung_di" bpmnElement="T_DT_KA4_Doppelfoerderung"><dc:Bounds x="470" y="40" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_DT_KA4_Interessenkonflikte_di" bpmnElement="T_DT_KA4_Interessenkonflikte"><dc:Bounds x="470" y="220" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_Join_di" bpmnElement="G_Join"><dc:Bounds x="670" y="145" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_KT_di" bpmnElement="T_KT"><dc:Bounds x="770" y="130" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_PB_di" bpmnElement="End_PB"><dc:Bounds x="970" y="152" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="116" y="170" /><di:waypoint x="170" y="170" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="320" y="170" /><di:waypoint x="370" y="170" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="395" y="145" /><di:waypoint x="395" y="80" /><di:waypoint x="470" y="80" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="395" y="195" /><di:waypoint x="395" y="260" /><di:waypoint x="470" y="260" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="620" y="80" /><di:waypoint x="695" y="80" /><di:waypoint x="695" y="145" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="620" y="260" /><di:waypoint x="695" y="260" /><di:waypoint x="695" y="195" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="720" y="170" /><di:waypoint x="770" y="170" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="920" y="170" /><di:waypoint x="970" y="170" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
