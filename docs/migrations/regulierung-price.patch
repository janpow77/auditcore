diff --git a/backend/tests/test_auditcore_preis_bindung.py b/backend/tests/test_auditcore_preis_bindung.py
new file mode 100644
index 0000000..0609361
--- /dev/null
+++ b/backend/tests/test_auditcore_preis_bindung.py
@@ -0,0 +1,137 @@
+"""Bindung an auditcore_price_analysis und auditcore_price_sources.
+
+Geprüft werden: Rechenkern und Tarifauswahl stammen aus der installierten
+Bibliothek (Legacy-Vertrag, unverändertes Verhalten), die Connectoren laufen
+über die Adapter und speichern dieselben Fachzeilen wie zuvor; fehlerhafte
+Antworten werden als ``teilweise`` sichtbar.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from importlib.metadata import version
+from types import SimpleNamespace
+
+import httpx
+
+from app.services import calculator, preisauswahl
+from app.services.external_apis.bundesbank import BundesbankConnector
+from app.services.external_apis.overpass import HESSEN_TANKSTELLEN_QUERY, OverpassConnector
+
+
+class _Ergebnis:
+    def __init__(self, zeilen=()):
+        self._zeilen = list(zeilen)
+
+    def scalar_one_or_none(self):
+        return None
+
+    def fetchall(self):
+        return self._zeilen
+
+
+class _Sitzung:
+    def __init__(self, osm=()):
+        self.eintraege: list = []
+        self.osm = list(osm)
+
+    def add(self, obj) -> None:
+        self.eintraege.append(obj)
+
+    async def flush(self) -> None:
+        return None
+
+    async def commit(self) -> None:
+        return None
+
+    async def rollback(self) -> None:
+        return None
+
+    async def execute(self, _stmt):
+        return _Ergebnis([(k,) for k in self.osm])
+
+
+def _registry():
+    return SimpleNamespace(
+        id=1, basis_url="https://example.invalid/api", secret_env_var=None, auth_typ="none",
+        konfiguration={}, letzter_lauf=None, letzter_status=None, letzte_fehlermeldung=None,
+    )
+
+
+def _mit_antwort(monkeypatch, antwort) -> None:
+    original = httpx.Client
+
+    class Client(original):
+        def __init__(self, *args, **kwargs):
+            kwargs["transport"] = httpx.MockTransport(antwort)
+            super().__init__(*args, **kwargs)
+
+    monkeypatch.setattr(httpx, "Client", Client)
+
+
+def test_rechenkern_und_auswahl_kommen_aus_der_bibliothek():
+    assert version("auditcore_price_analysis") == "0.1.0"
+    assert calculator.calculate_nahwaerme.__module__ == "auditcore_price_analysis.legacy"
+    assert preisauswahl.waehle_wasser_preis.__module__ == "auditcore_price_analysis.legacy"
+    ergebnis = calculator.calculate_wasser(
+        {"grundpreis_eur_monat": 0, "arbeitspreis_eur_m3": 1.07,
+         "verrechnungspreis_eur_monat": 0, "wasserentnahmeentgelt_eur_m3": 0},
+        m3=2.5,
+    )
+    assert ergebnis["jahreskosten"] == 2.68
+
+
+def test_bundesbank_speichert_kurse_und_zeigt_fehlwerte(monkeypatch):
+    assert version("auditcore_price_sources") == "0.1.0"
+    daten = {
+        "data": {
+            "structure": {
+                "dimensions": {
+                    "series": [
+                        {"id": "BBK_STD_CURRENCY", "values": [{"id": "USD"}]},
+                        {"id": "BBK_ERX_PARTNER_CURRENCY", "values": [{"id": "EUR"}]},
+                    ],
+                    "observation": [{"values": [{"id": "2026-09-01"}, {"id": "2026-09-02"}]}],
+                },
+                "attributes": {"series": [], "observation": []},
+            },
+            "dataSets": [{"series": {"0:0": {"observations": {"0": ["1.1050"], "1": [None]}}}}],
+        }
+    }
+    _mit_antwort(monkeypatch, lambda r: httpx.Response(200, json=daten))
+    sitzung = _Sitzung()
+    connector = BundesbankConnector(_registry(), sitzung)
+    ergebnis = asyncio.run(connector.harvest())
+    kurse = [e for e in sitzung.eintraege if type(e).__name__ == "Wechselkurs"]
+    assert ergebnis.status == "erfolg" and ergebnis.anzahl_datensaetze == 1
+    assert [(str(k.stichtag), str(k.kurs)) for k in kurse] == [("2026-09-01", "1.1050")]
+    assert ergebnis.metadaten["fehlwerte"] == 1
+    assert ergebnis.metadaten["einheit"] == "USD je 1 EUR"
+    assert ergebnis.paket_sha256 == connector._sha256(json.dumps(daten, sort_keys=True).encode())
+
+
+def test_overpass_legt_tankstellen_wie_bisher_an_und_meldet_teilergebnis(monkeypatch):
+    daten = {
+        "osm3s": {"timestamp_osm_base": "2026-09-01T06:00:00Z"},
+        "elements": [
+            {"type": "node", "id": 1, "lat": 50.1, "lon": 8.6, "tags": {"brand": "B"}},
+            {"type": "way", "id": 2, "tags": {"name": "ohne Koordinaten"}},
+        ],
+        "remark": "runtime error: Query timed out",
+    }
+
+    def antwort(request):
+        assert request.method == "POST"
+        assert b"out+center+tags" in request.content
+        return httpx.Response(200, json=daten)
+
+    _mit_antwort(monkeypatch, antwort)
+    sitzung = _Sitzung()
+    ergebnis = asyncio.run(OverpassConnector(_registry(), sitzung).harvest())
+    stationen = [e for e in sitzung.eintraege if type(e).__name__ == "Tankstelle"]
+    assert [(s.mtsk_id, s.name, s.plz, s.ort) for s in stationen] == [
+        ("osm-node-1", "B", "00000", "Unbekannt")
+    ]
+    assert ergebnis.status == "teilweise" and "Query timed out" in ergebnis.fehlermeldung
+    assert "out center tags;" in HESSEN_TANKSTELLEN_QUERY
