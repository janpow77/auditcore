 """
 HPP Calculator - Kern-Berechnungslogik.
 
-Nahwärme und Wasser Preisberechnungen nach Anhang C.
-Testabgesichert durch pytest (test_calculator.py).
+Die Berechnung kommt aus der Bibliothek ``auditcore_price_analysis``
+(janpow77/auditcore). Dieses Modul bindet deren Legacy-Vertrag, der das
+bisherige Verhalten fallgenau nachbildet (274 charakterisierte Fälle);
+Aufrufer und API bleiben unverändert. Der korrigierte Vertrag
+(``auditcore_price_analysis.calculate`` mit versionierten Profilen) ist für
+die schrittweise Umstellung vorgesehen; offene Fachentscheidungen PA-H01 bis
+PA-H04 siehe docs/behavior-changes.md der Bibliothek.
 
 Formeln:
   Nahwärme: G = (P_G × Q_kW) + (P_A × Q_kWh / 100) + P_V + (P_E × Q_kWh / 100) + (P_U × Q_kWh / 100)
   Wasser:   G = GP(Q3) × 12 + (V_m³ × AP) + VP × 12 [+ V_m³ × WEE]
 """
 
-from datetime import date
-from decimal import ROUND_HALF_UP, Decimal, InvalidOperation
-
-# Umlagen-Stichtag: Ab 01.07.2025 gilt Wärmeumlagenpreis statt Gasspeicherumlage
-UMLAGEN_STICHTAG = date(2025, 7, 1)
-CENT = Decimal("0.01")
-ZEHNTEL = Decimal("0.1")
-
-
-def _decimal(value: object, *, feld: str, default: str = "0") -> Decimal:
-    """Konvertiert externe Zahlen verlustfrei und lehnt ungueltige Werte ab."""
-    if value is None:
-        value = default
-    try:
-        result = Decimal(str(value))
-    except (InvalidOperation, ValueError, TypeError) as exc:
-        raise ValueError(f"{feld} muss eine gueltige Zahl sein") from exc
-    if not result.is_finite():
-        raise ValueError(f"{feld} muss endlich sein")
-    return result
-
-
-def _nicht_negativ(value: object, *, feld: str) -> Decimal:
-    result = _decimal(value, feld=feld)
-    if result < 0:
-        raise ValueError(f"{feld} darf nicht negativ sein")
-    return result
-
-
-def _round(value: Decimal, places: Decimal = CENT) -> float:
-    """Explizite kaufmaennische Rundung fuer API-Ergebnisse."""
-    return float(value.quantize(places, rounding=ROUND_HALF_UP))
