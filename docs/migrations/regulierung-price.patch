@@ -81,3 +81,76 @@ class LaufZustand:
         if self.stand.get(checkpoint.source_id) != expected:
             raise CheckpointConflict("Checkpoint wurde parallel geändert.")
         self.stand[checkpoint.source_id] = checkpoint
+
+
+class LokaleUhr:
+    """Uhr des Kerns in lokaler Zeitzone (Zeitfenster wie bisher ``date.today()``)."""
+
+    def now(self) -> Any:
+        from datetime import datetime
+
+        return datetime.now().astimezone()
+
+    def monotonic(self) -> float:
+        import time
+
+        return time.monotonic()
+
+
+class Warten:
+    """Wartezeiten des Kerns (Wiederholungen, Rate-Limit)."""
+
+    def sleep(self, seconds: float) -> None:
+        import time
+
+        time.sleep(seconds)
+
+
+class Zugang:
+    """Zugangsdaten eines einzelnen Laufs ``{(source_id, name): wert}``; nie protokolliert."""
+
+    def __init__(self, werte: dict[tuple[str, str], str | None] | None = None) -> None:
+        self._werte = {k: v for k, v in (werte or {}).items() if v}
+
+    def get(self, source_id: str, name: str) -> str | None:
+        return self._werte.get((source_id, name))
+
+
+def fuehre_aus(
+    adapter: Any,
+    konfiguration: dict[str, Any],
+    *,
+    user_agent: str,
+    timeout: float,
+    zugang: dict[tuple[str, str], str | None] | None = None,
+    filter: dict[str, Any] | None = None,
+) -> tuple[Any, list[HarvestRecord], list[Any]]:
+    """Ein begrenzter Lauf über ``auditcore_harvest`` (synchron, für ``asyncio.to_thread``).
+
+    Liefert das strukturierte Kernergebnis, die Datensätze in Abrufreihenfolge
+    und die Quellen-Snapshots (Rohantworten ohne Geheimnisse) für Paket-Hash
+    und Archiv. Wiederholungen sind auf zwei Versuche begrenzt, Retry-After
+    auf höchstens 30 Sekunden.
+    """
+    from auditcore_harvest import HarvestEngine, HarvestRequest, RetryPolicy
+    from auditcore_price_sources import RecordingTransport
+
+    transport = RecordingTransport(HttpxTransport(user_agent))
+    senke = LaufSenke()
+    kern = HarvestEngine(
+        transport=transport,
+        credentials=Zugang(zugang),
+        state=LaufZustand(),
+        clock=LokaleUhr(),
+        sleeper=Warten(),
+        retry=RetryPolicy(max_attempts=2, base_delay=1.0, max_retry_after=30.0),
+        request_timeout=timeout,
+    )
+    quelle = adapter.source.source_id
+    ergebnis = kern.run(
+        adapter,
+        HarvestRequest(quelle, run_id=quelle, filters=filter or {}, resume=False),
+        senke,
+        config=konfiguration,
+    )
+    return ergebnis, list(senke.datensaetze.values()), list(transport.snapshots)
