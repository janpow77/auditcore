{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/janpow77/auditcore/schemas/auditcore_kanban.board/1",
  "title": "auditcore_kanban board document",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "owner_id",
    "version",
    "columns",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "auditcore_kanban.board/1"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean"
    },
    "archived": {
      "type": "boolean"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "shares": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/share"
      }
    },
    "transitions": {
      "$ref": "#/$defs/transitions"
    },
    "extra": {
      "type": "object"
    },
    "wip_mode": {
      "enum": [
        "block",
        "warn"
      ]
    }
  },
  "$defs": {
    "rank": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]*[1-9A-Za-z]$"
    },
    "column": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,49}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "color": {
          "type": "string"
        },
        "wip_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "done": {
          "type": "boolean"
        },
        "status_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "column_id",
        "rank",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "column_id": {
          "type": "string"
        },
        "rank": {
          "$ref": "#/$defs/rank"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "priority": {
          "enum": [
            "hoch",
            "mittel",
            "niedrig"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "due": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "badge": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "done"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "done": {
                "type": "boolean"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "target"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "filename"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "mime_type": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        }
      }
    },
    "label": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "share": {
      "type": "object",
      "required": [
        "user_id",
        "permission"
      ],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string"
        },
        "permission": {
          "enum": [
            "read",
            "edit"
          ]
        },
        "shared_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "locked_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed_order_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "free",
            "restricted"
          ]
        }
      }
    }
  }
}
