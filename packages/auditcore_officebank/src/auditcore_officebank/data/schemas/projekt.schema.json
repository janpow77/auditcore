{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditcore-officebank/projekt/1",
  "title": "Projektdatei der officebank (.officebank.toml)",
  "description": "Projektangaben ohne Rechner- und Netzangaben. Die Tabellen datenschutz, gast, schritte, dialogregeln, build, paket, schwaerzung und upload sind für spätere Etappen reserviert.",
  "type": "object",
  "required": ["schema", "projekt"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "auditcore-officebank/projekt/1"},
    "projekt": {
      "type": "object",
      "required": ["kuerzel", "host"],
      "properties": {
        "kuerzel": {"type": "string", "minLength": 1},
        "host": {"enum": ["excel", "access", "word"]},
        "quelle": {"type": "string", "minLength": 1, "default": "src"}
      }
    },
    "module": {
      "type": "object",
      "properties": {
        "reihenfolge": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "modulliste": {"type": "string", "minLength": 1}
      }
    },
    "lint": {
      "type": "object",
      "properties": {"profil": {"type": "string", "minLength": 1}}
    },
    "datenschutz": {"type": "object"},
    "gast": {"type": "object"},
    "schritte": {"type": "object"},
    "dialogregeln": {"type": "object"},
    "build": {"type": "object"},
    "paket": {"type": "object"},
    "schwaerzung": {"type": "object"},
    "upload": {"type": "object"}
  }
}
