    "entries": [
      {
        "number": 1,
        "title": {
          "de": "Angemessene Aufgabentrennung und angemessene schriftliche Vereinbarungen für Berichterstattung, Aufsicht und Überwachung der an eine zwischengeschaltete Stelle delegierten Aufgaben",
          "en": "Appropriate separation of functions and written arrangements for reporting, supervising and monitoring of delegated tasks to an intermediate body"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 2,
        "title": {
          "de": "Angemessene Kriterien und Verfahren für die Auswahl von Vorhaben",
          "en": "Appropriate criteria and procedures for the selection of operations"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": [],
        "footnote": {
          "de": "Territoriale Behörden oder Stellen gemäß Artikel 29 Absatz 3 der vorliegenden Verordnung und, falls zutreffend, Lenkungsausschuss gemäß Artikel 22 Absatz 2 der Interreg-Verordnung.",
          "en": "Territorial authorities or bodies pursuant to Article 29(3) of this Regulation and steering committee pursuant to Article 22(2) of Interreg Regulation, where applicable."
        }
      },
      {
        "number": 3,
        "title": {
          "de": "Angemessene Information der Begünstigten zu den anwendbaren Bedingungen für die Unterstützung der ausgewählten Vorhaben",
          "en": "Appropriate information to beneficiaries on applicable conditions for support for the selected operations"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 4,
        "title": {
          "de": "Angemessene Verwaltungsüberprüfungen, einschließlich angemessener Verfahren für die Überprüfungen, ob die Bedingungen für nicht mit Kosten verknüpfte Finanzierungen und für vereinfachte Kostenoptionen erfüllt sind",
          "en": "Appropriate management verifications, including appropriate procedures for checking fulfilment of conditions for financing not linked to costs and for simplified cost options"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 5,
        "title": {
          "de": "Wirksame Systeme zur Gewährleistung, dass alle für den Prüfpfad notwendigen Unterlagen aufbewahrt werden",
          "en": "Effective system to ensure that all documents necessary for the audit trail are held"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 6,
        "title": {
          "de": "Zuverlässiges elektronisches System (mit Verbindungen zu elektronischen Datenaustauschsystemen mit Begünstigten) für die Aufzeichnung und Speicherung der Daten für Überwachung, Evaluierung, Finanzmanagement, Überprüfungen und Prüfungen, u. a. angemessene Abläufe zur Sicherstellung der Sicherheit, Integrität und Vertraulichkeit von Daten und der Authentifizierung von Nutzern",
          "en": "Reliable electronic system (including links with electronic data exchange systems with beneficiaries) for recording and storing data for monitoring, evaluation, financial management, verifications and audits, including appropriate processes to ensure the security, integrity and confidentiality of the data and the authentication of users"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 7,
        "title": {
          "de": "Wirksame Umsetzung angemessener Betrugsbekämpfungsmaßnahmen",
          "en": "Effective implementation of proportionate anti-fraud measures"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 8,
        "title": {
          "de": "Angemessene Verfahren zur Erstellung der Verwaltungserklärung",
          "en": "Appropriate procedures for drawing up the management declaration"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 9,
        "title": {
          "de": "Angemessene Verfahren zur Bestätigung, dass die verbuchten Ausgaben rechtmäßig und ordnungsmäßig sind",
          "en": "Appropriate procedures for confirming that the expenditure entered into the accounts is legal and regular"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 10,
        "title": {
          "de": "Angemessene Verfahren zur Erstellung und Einreichung von Zahlungsanträgen und der Rechnungslegung und zur Bestätigung der Vollständigkeit, Genauigkeit und sachlichen Richtigkeit der Rechnungslegung",
          "en": "Appropriate procedures for drawing up and submission of payment applications and of accounts and confirming completeness, accuracy and veracity of the accounts"
        },
        "bodies": {
          "de": "Verwaltungsbehörde/für den Aufgabenbereich „Rechnungsführung“ zuständige Stelle",
          "en": "Managing authority/ Body carrying out the accounting function"
        },
        "assessment_criteria": []
      },
      {
        "number": 11,
        "title": {
          "de": "Angemessene Aufgabentrennung und funktionelle Unabhängigkeit zwischen der Prüfbehörde (und gegebenenfalls allen Stellen, die unter der Verantwortung der Prüfbehörde Prüfungstätigkeiten durchführen, auf die sich die Prüfbehörde verlässt und die sie beaufsichtigt) und den anderen Programmbehörden sowie den Prüfungstätigkeiten, die im Einklang mit international anerkannten Prüfungsstandards durchgeführt werden",
          "en": "Appropriate separation of functions and functional independence between the audit authority (and any body carrying out audit work under the responsibility of the audit authority on which the audit authority relies and supervises, if applicable) and the other programme authorities and audit work carried out in accordance with internationally accepted audit standards"
        },
        "bodies": {
          "de": "Prüfbehörde",
          "en": "Audit authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 12,
        "title": {
          "de": "Angemessene Systemprüfungen",
          "en": "Appropriate system audits"
        },
        "bodies": {
          "de": "Prüfbehörde",
          "en": "Audit authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 13,
        "title": {
          "de": "Angemessene Vorhabenprüfungen",
          "en": "Appropriate audits of operations"
        },
        "bodies": {
          "de": "Prüfbehörde",
          "en": "Audit authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 14,
        "title": {
          "de": "Angemessene Prüfungen der Rechnungslegung",
          "en": "Appropriate audits of accounts"
        },
        "bodies": {
          "de": "Prüfbehörde",
          "en": "Audit authority"
        },
        "assessment_criteria": []
      },
      {
        "number": 15,
        "title": {
          "de": "Angemessene Verfahren für die Erteilung eines zuverlässigen Bestätigungsvermerks und die Erstellung des jährlichen Kontrollberichts",
          "en": "Appropriate procedures for providing a reliable audit opinion and for preparing the annual control report"
        },
        "bodies": {
          "de": "Prüfbehörde",
          "en": "Audit authority"
        },
        "assessment_criteria": []
      }
    ],
    "assessment_criteria_note": {
      "de": "Der Rechtstext enthält keine Bewertungskriterien; sie stammen aus Leitlinien der Kommission und werden von der Anwendung eingespeist.",
