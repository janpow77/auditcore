      },
      {
        "number": 5,
        "title": {
          "de": "Vorhandensein eines wirksamen Systems, durch das gewährleistet ist, dass alle für einen hinreichenden Prüfpfad erforderlichen Dokumente zu Ausgaben und Prüfungen aufbewahrt werden",
          "en": "Effective system in place to ensure that all documents regarding expenditure and audits are held to ensure an adequate audit trail"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": [],
        "scope": {
          "de": "Verwaltungs- und Kontrolltätigkeiten/Überwachung",
          "en": "Management and control activities/Monitoring"
        }
      },
      {
        "number": 6,
        "title": {
          "de": "Zuverlässiges System, mit dessen Hilfe Daten zu Überwachungs-, Bewertungs-, Finanzmanagement-, Überprüfungs- und Prüfungszwecken erfasst, aufgezeichnet und gespeichert werden, einschließlich Verknüpfungen mit elektronischen Systemen zum Datenaustausch mit Begünstigten",
          "en": "Reliable system for collecting, recording and storing data for monitoring, evaluation, financial management, verification and audit purposes, including links with electronic data exchange systems with beneficiaries"
        },
        "bodies": {
          "de": "Verwaltungsbehörde",
          "en": "Managing authority"
        },
        "assessment_criteria": [],
        "scope": {
